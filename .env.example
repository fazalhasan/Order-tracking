# Shopify CLI supplies these values during app development.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders
SHOPIFY_APP_URL=
SHOPIFY_STORE_DOMAIN=
POSTGRES_PRISMA_URL=

# FedEx REST API credentials. Use FEDEX_ENVIRONMENT=sandbox for testing.
FEDEX_ENVIRONMENT=sandbox
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=

# Obtain the endpoint and field mapping from the merchant's official Leopards API documentation.
LEOPARDS_API_URL=
LEOPARDS_API_USERNAME=
LEOPARDS_API_PASSWORD=